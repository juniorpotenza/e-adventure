<?xml version="1.0"?>
<!-- Testes com stubs de WordPress, sem bootstrap do WP. Cada arquivo e uma suite propria: os stubs de classes conflitam entre arquivos, entao rode uma suite por vez (veja ci.yml). -->
<phpunit colors="true" processIsolation="true">
    <testsuites>
        <testsuite name="f2"><file>tests/test-f2-privacy-account.php</file></testsuite>
        <testsuite name="f5"><file>tests/test-f5-extension-data.php</file></testsuite>
        <testsuite name="f6"><file>tests/test-f6-signature-hardening.php</file></testsuite>
        <testsuite name="f7"><file>tests/test-f7-participants-display.php</file></testsuite>
        <testsuite name="f4"><file>tests/test-f4-guide-scope.php</file></testsuite>
        <testsuite name="t2"><file>tests/test-t2-assinatura.php</file></testsuite>
        <testsuite name="t4"><file>tests/test-t4-scanner.php</file></testsuite>
        <testsuite name="t6"><file>tests/test-t6-legal-privacy.php</file></testsuite>
        <testsuite name="t7"><file>tests/test-t7-ux.php</file></testsuite>
        <testsuite name="t8"><file>tests/test-t8-utils.php</file></testsuite>
    </testsuites>
</phpunit>
